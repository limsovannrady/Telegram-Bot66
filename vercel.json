{
  "buildCommand": "npm install -g pnpm && pnpm install && pnpm --filter @workspace/username-checker run build",
  "outputDirectory": "artifacts/username-checker/dist/public",
  "installCommand": "npm install -g pnpm && pnpm install",
  "framework": null,
  "routes": [
    {
      "src": "/api/webhook",
      "dest": "/api/webhook.py"
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ]
}
